# Copy to .env at the repo root and fill in what you have. Every variable is optional:
# the game runs without any of them, with clearly labelled local fallbacks.
# Never commit .env. Server-only variables never reach the client bundle; only PRIVY_APP_ID does.

# ---- server ------------------------------------------------------------------------------------

# HTTP and WebSocket port for the game server. Default 8787.
PORT=

# Database. postgres://user:pass@host:5432/db uses real Postgres through pg.
# pglite://<dir> uses embedded PGlite stored in <dir>; memory:// keeps it in memory.
# Default pglite://.data/coys
DATABASE_URL=

# Secret for signing session tokens (any long random string). If unset, a random one is made
# at boot and every session ends when the server restarts.
SESSION_SECRET=

# 1 allows the local dev login even when PRIVY_APP_ID is set. When PRIVY_APP_ID is unset the
# dev login is always on, and labelled as such on the login screen.
ALLOW_DEV_LOGIN=

# ---- login (Privy) -------------------------------------------------------------------------------

# Public Privy app id from dashboard.privy.io. Used by the client (login modal, silent NEAR wallet)
# and by the server (token audience).
PRIVY_APP_ID=

# Privy verification public key (PEM, from Configuration > App settings in the Privy dashboard).
# If unset the server fetches Privy's JWKS for the app id instead.
PRIVY_VERIFICATION_KEY=

# ---- NEAR testnet settlement (server only, never in the client) ----------------------------------

# Testnet account that signs the daily settlement batch, for example coys-settle.testnet.
NEAR_TESTNET_ACCOUNT_ID=

# Full-access private key of that account, ed25519:... . Testnet only.
NEAR_TESTNET_PRIVATE_KEY=

# Testnet JSON-RPC endpoint. Default https://test.rpc.fastnear.com
NEAR_TESTNET_RPC_URL=

# Account that holds the settlement log contract. Default: NEAR_TESTNET_ACCOUNT_ID.
# Deploy it once with: npm run deploy-settlement-log -w @coys/server
NEAR_SETTLEMENT_CONTRACT_ID=

# ---- NEAR AI Cloud (agent brains) ---------------------------------------------------------------

# API key from cloud.near.ai. Without it rival agents use the built-in heuristic brain.
NEARAI_API_KEY=

# OpenAI-compatible base URL. Default https://cloud-api.near.ai/v1
NEARAI_BASE_URL=

# Model id. Default zai-org/GLM-5.1-FP8
NEARAI_MODEL=

# ---- tools ---------------------------------------------------------------------------------------

# Path to a clone of iam25th1/coys-assets, read by npm run pack-assets.
ASSETS_DIR=
