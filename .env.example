# Copy to .env at the repo root and fill in what you have. Every variable is optional:
# the game runs without any of them, with clearly labelled local fallbacks.
# Never commit .env. Server-only variables never reach the client bundle; only PRIVY_APP_ID does.

# ---- server ------------------------------------------------------------------------------------

# production on a deployed server (Pier, Render). Production requires GAME_SEASON, SESSION_SECRET and a real
# Postgres DATABASE_URL. Leave empty for local play.
NODE_ENV=

# HTTP and WebSocket port for the game server. Default 8787.
PORT=

# Address to listen on, for example 127.0.0.1 behind a tunnel on the same machine (Pier sets it).
# Unset means every interface, which hosts such as Render need.
HOST=

# 1 lets a production build run on PGlite, only to check the build where no Postgres is reachable.
# Never for players.
ALLOW_PGLITE_IN_PRODUCTION=

# Seconds in one in-game day for recording a demo (20 to 3600). Unset means 180. Ignored when
# NODE_ENV is production unless DEMO_MODE=1.
DEMO_DAY_SECONDS=

# 1 lets DEMO_DAY_SECONDS work on a production server (for a recording session only).
DEMO_MODE=

# Days settled on NEAR testnet in one call (1 to 100). Unset means 10: the closed days wait, and every
# tenth close sends one settle_day call for the range, its digest the SHA-256 of all their records.
SETTLE_EVERY_DAYS=

# Season id (1 to 32 characters of a-z, 0-9 and -), for example s1. One database holds one season
# and the contract settles days as (season, day), so a new season (fresh database) starts again at
# day 1. Required in production. Unset locally: a fresh database makes its own dev-... season.
GAME_SEASON=

# Database. postgres://user:pass@host:5432/db uses real Postgres through pg.
# pglite://<dir> uses embedded PGlite stored in <dir>; memory:// keeps it in memory.
# Default pglite://.data/coys
DATABASE_URL=

# Secret for signing session tokens (any long random string). If unset, a random one is made
# at boot and every session ends when the server restarts.
SESSION_SECRET=

# 1 allows the local dev login even when PRIVY_APP_ID is set. When PRIVY_APP_ID is unset the
# dev login is always on, and labelled as such on the login screen.
ALLOW_DEV_LOGIN=

# ---- login (Privy) -------------------------------------------------------------------------------

# Public Privy app id from dashboard.privy.io. Used by the client (login modal, silent NEAR wallet)
# and by the server (token audience).
PRIVY_APP_ID=

# Privy verification public key (PEM, from Configuration > App settings in the Privy dashboard).
# If unset the server fetches Privy's JWKS for the app id instead.
PRIVY_VERIFICATION_KEY=

# ---- NEAR testnet settlement (server only, never in the client) ----------------------------------

# Testnet account that signs the daily settlement batch, for example coys-settle.testnet.
NEAR_TESTNET_ACCOUNT_ID=

# Full-access private key of that account, ed25519:... . Testnet only.
NEAR_TESTNET_PRIVATE_KEY=

# Testnet JSON-RPC endpoint. Default https://test.rpc.fastnear.com
NEAR_TESTNET_RPC_URL=

# Account that holds the game contract (the Feathers, egg tokens, daily settlement). Default:
# NEAR_TESTNET_ACCOUNT_ID. Deploy with npm run deploy-contract (see deploy/testnet.md). Agent
# wallets are created as sub-accounts of NEAR_TESTNET_ACCOUNT_ID.
NEAR_GAME_CONTRACT_ID=

# NEAR kept free for each Feather minted: its measured cost on testnet (1,913 to 2,075 bytes of
# storage and about 0.0005 NEAR of gas, 0.0213 in all) and a quarter more. Default 0.027. Feathers
# mint one at a time as tickets are redeemed, only while the free balance stores one above the
# margin below.
CHAIN_MINT_NEAR=

# Margin of available NEAR on the game account under which Feather mints and agent wallet links
# wait, kept for the days' settlements: a settled day stores nothing and burns about 0.00084 NEAR
# of gas (measured), so the default 0.1 is about 120 day closes, six real hours at 3-minute days.
CHAIN_MIN_BALANCE_NEAR=

# NEAR sent from the game account to each new agent sub-account wallet. Default 0.01: a wallet's
# own storage needs 0.0018 and it never pays for anything itself.
AGENT_ACCOUNT_FUNDING_NEAR=

# ---- NEAR AI Cloud (agent brains) ---------------------------------------------------------------

# API key from cloud.near.ai. Without it the seven agents use their rule policies.
NEARAI_API_KEY=

# OpenAI-compatible base URL. Default https://cloud-api.near.ai/v1
NEARAI_BASE_URL=

# Main model (must support structured outputs): weekly reflections and hard days (a crash or glut,
# or an agent short of cash). Default Qwen/Qwen3.6-35B-A3B-FP8
NEARAI_MODEL=

# Cheap model for routine days. Default z-ai/glm-5.3-flash
NEARAI_CHEAP_MODEL=

# Hard cap on NEAR AI Cloud spend per UTC day, in USD, every agent together. Past it, agents use
# their rules. Default 1.00
NEARAI_DAILY_SPEND_CAP_USD=

# Cap per agent per UTC day: USD (default a quarter of the global cap) and calls (default 40). Past
# either, that agent uses its rules. docs/agents.md has the credits these imply.
NEARAI_AGENT_DAILY_CAP_USD=
NEARAI_AGENT_DAILY_CALLS=

# Prices per million tokens as "input,output" USD, for the caps. Default: /v1/models, else the
# assumed prices in apps/server/src/agents/brain.ts (main 0.2,0.8; cheap 0.1,0.4).
NEARAI_MAIN_PRICE=
NEARAI_CHEAP_PRICE=

# ---- tools ---------------------------------------------------------------------------------------

# Path to a clone of iam25th1/coys-assets, read by npm run pack-assets.
ASSETS_DIR=
